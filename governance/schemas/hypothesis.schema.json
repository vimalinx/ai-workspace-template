{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vimalinx/ai-workspace-template/governance/schemas/hypothesis.schema.json",
  "title": "Autonomous Workspace Hypothesis",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "object_type": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 3
    },
    "item": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "falsification": {
      "type": "string",
      "minLength": 1
    },
    "source_node_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_for": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_against": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "object_type",
    "id",
    "item",
    "status",
    "created_at",
    "updated_at",
    "statement",
    "falsification"
  ]
}
