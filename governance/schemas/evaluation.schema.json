{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vimalinx/ai-workspace-template/governance/schemas/evaluation.schema.json",
  "title": "Autonomous Workspace Evaluation",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "object_type": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 3
    },
    "item": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluator": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "rubric": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "object_type",
    "id",
    "item",
    "status",
    "created_at",
    "updated_at",
    "experiment_id",
    "evaluator",
    "result",
    "summary"
  ]
}
